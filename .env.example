# Hermes API Server (OpenAI-compatible), reached through the Cloudflare tunnel
HERMES_API_URL=
HERMES_API_KEY=

# Owner-only dashboard at /admin/chat-logs (the admin area returns 404 when unset)
ADMIN_TOKEN=

# Optional: Upstash Redis for chat logging (added by the Vercel Upstash integration).
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as a fallback.
# Without them, logging is silently disabled.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
